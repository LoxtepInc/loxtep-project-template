{
  "key": "shipstation_list_orders",
  "name": "List orders",
  "description": "GET /orders — paginated ShipStation orders.",
  "version": "1.0.0",
  "type": "action",
  "annotations": { "read_only": true, "destructive": false },
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "limit": { "type": "number", "description": "Mapped to pageSize (max 500)" },
      "page": { "type": "number" },
      "pageSize": { "type": "number" },
      "orderStatus": { "type": "string" },
      "createDateStart": { "type": "string" },
      "createDateEnd": { "type": "string" },
      "modifyDateStart": { "type": "string" },
      "modifyDateEnd": { "type": "string" },
      "orderDateStart": { "type": "string" },
      "orderDateEnd": { "type": "string" },
      "sortBy": { "type": "string" },
      "sortDir": { "type": "string" }
    }
  },
  "execution": {
    "protocol": "catalog_http_get",
    "method": "GET",
    "base_url_template": "https://ssapi.shipstation.com",
    "path": "/orders",
    "static_headers": { "Accept": "application/json" },
    "header_auth": {
      "header": "Authorization",
      "basic": true,
      "basic_user_from": "username"
    },
    "query_mapping": {
      "page": "input.page",
      "pageSize": "input.limit",
      "orderStatus": "input.orderStatus",
      "createDateStart": "input.createDateStart",
      "createDateEnd": "input.createDateEnd",
      "modifyDateStart": "input.modifyDateStart",
      "modifyDateEnd": "input.modifyDateEnd",
      "orderDateStart": "input.orderDateStart",
      "orderDateEnd": "input.orderDateEnd",
      "sortBy": "input.sortBy",
      "sortDir": "input.sortDir"
    },
    "omit_empty_query": true
  }
}
