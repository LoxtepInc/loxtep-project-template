{
  "$schema": "https://loxtep.io/schemas/template/connector.json",
  "template_type": "connector",
  "catalog_visible": true,
  "slug": "clickup",
  "name": "ClickUp Connector",
  "description": "Connect to ClickUp to sync tasks, lists, folders, spaces, workspaces, and goals via the public REST API (OAuth 2.0).",
  "version": "1.1.0",
  "tags": [
    "clickup",
    "productivity",
    "project-management",
    "scheduling",
    "tasks"
  ],
  "use_cases": [
    "Task and project sync",
    "Workspace hierarchy ingestion",
    "Goals and lists data integration"
  ],
  "entity": {
    "connector_id": "{{CONNECTOR_ID}}",
    "organization_id": "{{ORGANIZATION_ID}}",
    "project_id": "{{PROJECT_ID}}",
    "connector_type": "clickup",
    "name": "ClickUp",
    "description": "ClickUp project management via CatalogRuntimeConnector (tasks, lists, folders, spaces, workspaces, goals)",
    "category": "productivity",
    "auth_type": "oauth2",
    "icon_url": "/images/connectors/clickup.svg",
    "documentation_url": "https://developer.clickup.com/docs/authentication",
    "oauth_config": {
      "authorization_url": "https://app.clickup.com/api",
      "token_url": "https://api.clickup.com/api/v2/oauth/token",
      "scopes": [],
      "response_type": "code",
      "grant_type": "authorization_code"
    },
    "supported_directions": [
      "inbound"
    ],
    "supported_entities": [
      "workspaces",
      "tasks",
      "spaces",
      "folders",
      "lists",
      "goals"
    ],
    "supports_webhooks": false,
    "supports_polling": true,
    "version": "1.1.0",
    "is_beta": false,
    "metadata": {
      "template_slug": "clickup",
      "api_version": "v2"
    },
    "created_at": "{{CREATED_AT}}",
    "updated_at": "{{UPDATED_AT}}"
  },
  "connection_template": {
    "type": "api",
    "configuration": {
      "custom_settings": {
        "team_id": "{{TEAM_ID}}",
        "space_id": "{{SPACE_ID}}"
      }
    }
  },
  "placeholders": {
    "{{CONNECTOR_ID}}": "Generated UUID for the connector",
    "{{ORGANIZATION_ID}}": "Organization that owns this connector",
    "{{PROJECT_ID}}": "Project that contains this connector",
    "{{TEAM_ID}}": "ClickUp workspace (team) ID for team-scoped sync entities",
    "{{SPACE_ID}}": "ClickUp space ID for folders and folderless lists sync",
    "{{CREATED_AT}}": "ISO 8601 timestamp",
    "{{UPDATED_AT}}": "ISO 8601 timestamp"
  },
  "connector_package": {
    "schema_version": 1,
    "package_version": "1.1.0",
    "use_catalog_runtime": true,
    "description": "ClickUp REST API v2 via CatalogRuntimeConnector. Workspaces use GET /api/v2/team; team-scoped entities need custom_settings.team_id; folder/list hierarchy under a space needs custom_settings.space_id.",
    "follow_up_notes": [
      "ClickUp OAuth token exchange expects JSON {client_id, client_secret, code} on POST /api/v2/oauth/token; platform default form-urlencoded exchange may need a ClickUp-specific oauth adapter or metadata flag \u2014 verify before relying on hosted OAuth.",
      "Filtered team tasks use 0-based `page` in ClickUp docs; CatalogRuntime query_page is 1-based (first fetch sends page=1). Confirm live paging or add page_index_base support; until then length===limit heuristic may skip page 0.",
      "lists sync covers folderless lists in a space only (GET /space/{id}/list). Folder-contained lists need GET /folder/{folder_id}/list as a follow-up action.",
      "Optional: entity_catalog.record_schema_path + schemas/entities/*.schema.json for CI-enforced row contracts."
    ],
    "execution_policy": {
      "allowed_host_suffixes": [
        "clickup.com"
      ],
      "allowed_path_patterns": [
        "^/api/v2/user$",
        "^/api/v2/team$",
        "^/api/v2/team/[^/]+/task$",
        "^/api/v2/team/[^/]+/space$",
        "^/api/v2/team/[^/]+/goal$",
        "^/api/v2/space/[^/]+/folder$",
        "^/api/v2/space/[^/]+/list$"
      ]
    },
    "connection_probe": {
      "action_key": "clickup_get_authorized_user",
      "records_path": "user",
      "required_field": "id",
      "account_info_mapping": {
        "user_id": "id",
        "username": "username",
        "email": "email",
        "timezone": "timezone"
      }
    },
    "sync_plan": {
      "entities": {
        "workspaces": {
          "fetch_action_key": "clickup_list_workspaces",
          "records_path": "teams",
          "pagination": "none",
          "id_field": "id"
        },
        "tasks": {
          "fetch_action_key": "clickup_list_team_tasks",
          "records_path": "tasks",
          "pagination": "query_page",
          "page_query_param": "page",
          "id_field": "id",
          "fetch_limit_cap": 100,
          "sync_input_defaults": {
            "include_closed": true,
            "subtasks": true
          }
        },
        "spaces": {
          "fetch_action_key": "clickup_list_spaces",
          "records_path": "spaces",
          "pagination": "none",
          "id_field": "id",
          "sync_input_defaults": {
            "archived": false
          }
        },
        "folders": {
          "fetch_action_key": "clickup_list_folders",
          "records_path": "folders",
          "pagination": "none",
          "id_field": "id",
          "sync_input_defaults": {
            "archived": false
          }
        },
        "lists": {
          "fetch_action_key": "clickup_list_folderless_lists",
          "records_path": "lists",
          "pagination": "none",
          "id_field": "id",
          "sync_input_defaults": {
            "archived": false
          }
        },
        "goals": {
          "fetch_action_key": "clickup_list_goals",
          "records_path": "goals",
          "pagination": "none",
          "id_field": "id"
        }
      }
    },
    "entity_catalog": {
      "workspaces": {
        "name": "Workspaces",
        "supports_incremental": false,
        "supports_full_sync": true,
        "supports_webhook": false,
        "default_sync_interval_minutes": 60,
        "max_batch_size": 100
      },
      "tasks": {
        "name": "Tasks",
        "supports_incremental": true,
        "supports_full_sync": true,
        "supports_webhook": false,
        "default_sync_interval_minutes": 15,
        "max_batch_size": 100
      },
      "spaces": {
        "name": "Spaces",
        "supports_incremental": false,
        "supports_full_sync": true,
        "supports_webhook": false,
        "default_sync_interval_minutes": 60,
        "max_batch_size": 100
      },
      "folders": {
        "name": "Folders",
        "supports_incremental": false,
        "supports_full_sync": true,
        "supports_webhook": false,
        "default_sync_interval_minutes": 60,
        "max_batch_size": 100
      },
      "lists": {
        "name": "Lists",
        "supports_incremental": false,
        "supports_full_sync": true,
        "supports_webhook": false,
        "default_sync_interval_minutes": 60,
        "max_batch_size": 100
      },
      "goals": {
        "name": "Goals",
        "supports_incremental": false,
        "supports_full_sync": true,
        "supports_webhook": false,
        "default_sync_interval_minutes": 60,
        "max_batch_size": 100
      }
    },
    "actions": [
      {
        "key": "clickup_get_authorized_user",
        "definition_path": "actions/get-authorized-user/definition.json"
      },
      {
        "key": "clickup_list_workspaces",
        "definition_path": "actions/list-workspaces/definition.json"
      },
      {
        "key": "clickup_list_team_tasks",
        "definition_path": "actions/list-team-tasks/definition.json"
      },
      {
        "key": "clickup_list_spaces",
        "definition_path": "actions/list-spaces/definition.json"
      },
      {
        "key": "clickup_list_folders",
        "definition_path": "actions/list-folders/definition.json"
      },
      {
        "key": "clickup_list_folderless_lists",
        "definition_path": "actions/list-folderless-lists/definition.json"
      },
      {
        "key": "clickup_list_goals",
        "definition_path": "actions/list-goals/definition.json"
      }
    ]
  }
}
