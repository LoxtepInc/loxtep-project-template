{
  "key": "shipbob_list_inventory",
  "name": "List inventory",
  "description": "GET /2026-07/inventory. Page size is PageSize (from input.limit). Continuation is the body next URL (links_next_query), not a Page index. Response envelope is { items, first, next, prev, last }.",
  "version": "1.0.0",
  "type": "action",
  "annotations": { "read_only": true, "destructive": false },
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "limit": {
        "type": "number",
        "description": "Sent as PageSize. 2026-07 inventory has no Page or Limit query param."
      },
      "cursor": {
        "type": "string",
        "description": "Continuation value extracted from the next URL query param cursor."
      }
    }
  },
  "execution": {
    "protocol": "catalog_http_get",
    "method": "GET",
    "base_url_template": "https://api.shipbob.com",
    "path": "/2026-07/inventory",
    "header_auth": {
      "header": "Authorization",
      "value_from": "connection.api_key",
      "bearer_prefix": true
    },
    "static_headers": {
      "shipbob_channel_id": "{{connection.custom_settings.channel_id}}"
    },
    "query_mapping": {
      "PageSize": "input.limit",
      "cursor": "input.cursor"
    },
    "omit_empty_query": true
  }
}
