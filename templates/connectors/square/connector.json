{
  "$schema": "https://loxtep.io/schemas/template/connector.json",
  "template_type": "connector",
  "catalog_visible": true,
  "slug": "square",
  "name": "Square Connector",
  "description": "Sync Square locations, customers, payments, and catalog objects.",
  "version": "1.0.0",
  "tags": [
    "square",
    "payments",
    "pos"
  ],
  "use_cases": [
    "Sync Square locations, customers, payments, and catalog objects."
  ],
  "entity": {
    "connector_id": "{{CONNECTOR_ID}}",
    "organization_id": "{{ORGANIZATION_ID}}",
    "project_id": "{{PROJECT_ID}}",
    "connector_type": "square",
    "name": "Square",
    "description": "Sync Square locations, customers, payments, and catalog objects.",
    "category": "finance",
    "auth_type": "api_key",
    "oauth_config": null,
    "supported_directions": [
      "inbound"
    ],
    "supported_entities": [
      "locations",
      "customers",
      "payments",
      "catalog"
    ],
    "supports_webhooks": false,
    "supports_polling": true,
    "required_scopes": null,
    "version": "1.0.0",
    "is_beta": false,
    "metadata": {
      "template_slug": "square"
    },
    "created_at": "{{CREATED_AT}}",
    "updated_at": "{{UPDATED_AT}}"
  },
  "connection_template": {
    "type": "api",
    "configuration": {
      "api_key": "{{ACCESS_TOKEN}}"
    }
  },
  "placeholders": {
    "{{CONNECTOR_ID}}": "Generated UUID for the connector",
    "{{ORGANIZATION_ID}}": "Organization that owns this connector",
    "{{PROJECT_ID}}": "Project that contains this connector",
    "{{ACCESS_TOKEN}}": "Square access token (Bearer)",
    "{{CREATED_AT}}": "ISO 8601 timestamp",
    "{{UPDATED_AT}}": "ISO 8601 timestamp"
  },
  "connector_package": {
    "schema_version": 1,
    "package_version": "1.0.0",
    "use_catalog_runtime": true,
    "description": "Square Connect API via CatalogRuntimeConnector (Bearer). Fixed host connect.squareup.com. Sibling: stripe.",
    "follow_up_notes": [
      "Sandbox host connect.squareupsandbox.com is not in the allowlist; production only for this package.",
      "Orders Search is POST-only and omitted; payments + catalog cover common commerce sync."
    ],
    "execution_policy": {
      "allowed_host_suffixes": [
        "connect.squareup.com"
      ],
      "allowed_path_patterns": [
        "^/v2/locations$",
        "^/v2/customers$",
        "^/v2/payments$",
        "^/v2/catalog/list$"
      ]
    },
    "connection_probe": {
      "action_key": "square_list_locations",
      "records_path": "locations",
      "required_field": "id",
      "account_info_mapping": {
        "account_id": "id",
        "account_name": "name",
        "country": "country",
        "currency": "currency"
      }
    },
    "sync_plan": {
      "entities": {
        "locations": {
          "fetch_action_key": "square_list_locations",
          "records_path": "locations",
          "pagination": "none",
          "id_field": "id"
        },
        "customers": {
          "fetch_action_key": "square_list_customers",
          "records_path": "customers",
          "pagination": "cursor_from_body",
          "cursor_query_param": "cursor",
          "cursor_next_path": "cursor",
          "id_field": "id"
        },
        "payments": {
          "fetch_action_key": "square_list_payments",
          "records_path": "payments",
          "pagination": "cursor_from_body",
          "cursor_query_param": "cursor",
          "cursor_next_path": "cursor",
          "id_field": "id"
        },
        "catalog": {
          "fetch_action_key": "square_list_catalog",
          "records_path": "objects",
          "pagination": "cursor_from_body",
          "cursor_query_param": "cursor",
          "cursor_next_path": "cursor",
          "id_field": "id"
        }
      }
    },
    "entity_catalog": {
      "locations": {
        "name": "Locations",
        "record_schema_path": "schemas/entities/sync-row.schema.json",
        "supports_incremental": false,
        "supports_full_sync": true,
        "supports_webhook": false,
        "default_sync_interval_minutes": 60,
        "max_batch_size": 100
      },
      "customers": {
        "name": "Customers",
        "record_schema_path": "schemas/entities/sync-row.schema.json",
        "supports_incremental": true,
        "supports_full_sync": true,
        "supports_webhook": false,
        "default_sync_interval_minutes": 30,
        "max_batch_size": 100
      },
      "payments": {
        "name": "Payments",
        "record_schema_path": "schemas/entities/sync-row.schema.json",
        "supports_incremental": true,
        "supports_full_sync": true,
        "supports_webhook": false,
        "default_sync_interval_minutes": 15,
        "max_batch_size": 100
      },
      "catalog": {
        "name": "Catalog",
        "record_schema_path": "schemas/entities/sync-row.schema.json",
        "supports_incremental": true,
        "supports_full_sync": true,
        "supports_webhook": false,
        "default_sync_interval_minutes": 60,
        "max_batch_size": 100
      }
    },
    "actions": [
      {
        "key": "square_list_locations",
        "definition_path": "actions/list-locations/definition.json"
      },
      {
        "key": "square_list_customers",
        "definition_path": "actions/list-customers/definition.json"
      },
      {
        "key": "square_list_payments",
        "definition_path": "actions/list-payments/definition.json"
      },
      {
        "key": "square_list_catalog",
        "definition_path": "actions/list-catalog/definition.json"
      }
    ]
  }
}
