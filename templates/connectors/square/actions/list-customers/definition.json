{
  "key": "square_list_customers",
  "name": "List customers",
  "description": "GET /v2/customers",
  "version": "1.0.0",
  "type": "action",
  "annotations": {
    "read_only": true,
    "destructive": false
  },
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "limit": {
        "type": "number"
      },
      "cursor": {
        "type": "string"
      }
    }
  },
  "execution": {
    "protocol": "catalog_http_get",
    "method": "GET",
    "base_url_template": "https://connect.squareup.com",
    "path": "/v2/customers",
    "static_headers": {
      "Accept": "application/json",
      "Square-Version": "2024-01-18"
    },
    "header_auth": {
      "header": "Authorization",
      "value_from": "connection.api_key",
      "bearer_prefix": true
    },
    "query_mapping": {
      "limit": "input.limit",
      "cursor": "input.cursor"
    },
    "omit_empty_query": true
  }
}
