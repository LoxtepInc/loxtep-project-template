{
  "key": "salesforce_query_opportunities",
  "name": "Query Salesforce opportunities",
  "version": "1.0.0",
  "type": "action",
  "annotations": {
    "read_only": true,
    "destructive": false
  },
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "request_path": {
        "type": "string",
        "description": "SOQL query path or nextRecordsUrl path from a prior page."
      }
    }
  },
  "execution": {
    "protocol": "catalog_http_get",
    "method": "GET",
    "base_url_template": "{{connection.custom_settings.instance_url}}",
    "path": "{{input.request_path}}",
    "static_headers": {
      "Accept": "application/json"
    },
    "header_auth": {
      "header": "Authorization",
      "value_from": "connection.oauth_access_token",
      "bearer_prefix": true
    },
    "query_mapping": {},
    "omit_empty_query": true
  }
}
