{
  "key": "zendesk_list_users",
  "name": "List users",
  "description": "GET /api/v2/users.json (cursor pagination).",
  "version": "1.0.0",
  "type": "action",
  "annotations": {
    "read_only": true,
    "destructive": false
  },
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "limit": {
        "type": "number",
        "description": "page[size] (max 100)"
      },
      "cursor": {
        "type": "string",
        "description": "page[after] cursor"
      }
    }
  },
  "execution": {
    "protocol": "catalog_http_get",
    "method": "GET",
    "base_url_template": "https://{{connection.custom_settings.subdomain}}.zendesk.com",
    "path": "/api/v2/users.json",
    "static_headers": {
      "Accept": "application/json"
    },
    "header_auth": {
      "header": "Authorization",
      "basic": true,
      "basic_user_from": "username"
    },
    "query_mapping": {
      "page[size]": "input.limit",
      "page[after]": "input.cursor"
    },
    "omit_empty_query": true
  }
}
