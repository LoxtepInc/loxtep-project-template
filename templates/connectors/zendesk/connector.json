{
  "$schema": "https://loxtep.io/schemas/template/connector.json",
  "template_type": "connector",
  "catalog_visible": true,
  "slug": "zendesk",
  "name": "Zendesk Connector",
  "description": "Sync Zendesk Support tickets, users, and organizations.",
  "version": "1.0.0",
  "tags": [
    "zendesk",
    "support",
    "helpdesk"
  ],
  "use_cases": [
    "Sync Zendesk Support tickets, users, and organizations."
  ],
  "entity": {
    "connector_id": "{{CONNECTOR_ID}}",
    "organization_id": "{{ORGANIZATION_ID}}",
    "project_id": "{{PROJECT_ID}}",
    "connector_type": "zendesk",
    "name": "Zendesk",
    "description": "Sync Zendesk Support tickets, users, and organizations.",
    "category": "communication",
    "auth_type": "api_key",
    "oauth_config": null,
    "supported_directions": [
      "inbound"
    ],
    "supported_entities": [
      "tickets",
      "users",
      "organizations"
    ],
    "supports_webhooks": false,
    "supports_polling": true,
    "required_scopes": null,
    "version": "1.0.0",
    "is_beta": false,
    "metadata": {
      "template_slug": "zendesk"
    },
    "created_at": "{{CREATED_AT}}",
    "updated_at": "{{UPDATED_AT}}"
  },
  "connection_template": {
    "type": "api",
    "configuration": {
      "username": "{{EMAIL_TOKEN_USER}}",
      "api_key": "{{API_TOKEN}}",
      "custom_settings": {
        "subdomain": "{{SUBDOMAIN}}"
      }
    }
  },
  "placeholders": {
    "{{CONNECTOR_ID}}": "Generated UUID for the connector",
    "{{ORGANIZATION_ID}}": "Organization that owns this connector",
    "{{PROJECT_ID}}": "Project that contains this connector",
    "{{EMAIL_TOKEN_USER}}": "HTTP Basic username: `{agent_email}/token` (Zendesk API token auth)",
    "{{API_TOKEN}}": "Zendesk API token (HTTP Basic password)",
    "{{SUBDOMAIN}}": "Zendesk subdomain (e.g. acme for acme.zendesk.com)",
    "{{CREATED_AT}}": "ISO 8601 timestamp",
    "{{UPDATED_AT}}": "ISO 8601 timestamp"
  },
  "connector_package": {
    "schema_version": 1,
    "package_version": "1.0.0",
    "use_catalog_runtime": true,
    "description": "Zendesk Support API v2 via CatalogRuntimeConnector (Basic email/token + subdomain). Sibling pattern: gorgias.",
    "follow_up_notes": [
      "Replaces platform-native zendesk stub (providers/zendesk).",
      "Basic username must be `{email}/token`; password is the API token (connection.api_key).",
      "Cursor pagination uses page[size]/page[after] with meta.after_cursor."
    ],
    "execution_policy": {
      "allowed_host_suffixes": [
        ".zendesk.com"
      ],
      "allowed_path_patterns": [
        "^/api/v2/users/me\\.json$",
        "^/api/v2/tickets\\.json$",
        "^/api/v2/users\\.json$",
        "^/api/v2/organizations\\.json$"
      ]
    },
    "connection_probe": {
      "action_key": "zendesk_get_me",
      "records_path": "user",
      "required_field": "id",
      "account_info_mapping": {
        "account_id": "id",
        "account_name": "name",
        "email": "email"
      }
    },
    "sync_plan": {
      "entities": {
        "tickets": {
          "fetch_action_key": "zendesk_list_tickets",
          "records_path": "tickets",
          "pagination": "meta_cursor",
          "cursor_query_param": "cursor",
          "next_cursor_path": "meta.after_cursor",
          "id_field": "id"
        },
        "users": {
          "fetch_action_key": "zendesk_list_users",
          "records_path": "users",
          "pagination": "meta_cursor",
          "cursor_query_param": "cursor",
          "next_cursor_path": "meta.after_cursor",
          "id_field": "id"
        },
        "organizations": {
          "fetch_action_key": "zendesk_list_organizations",
          "records_path": "organizations",
          "pagination": "meta_cursor",
          "cursor_query_param": "cursor",
          "next_cursor_path": "meta.after_cursor",
          "id_field": "id"
        }
      }
    },
    "entity_catalog": {
      "tickets": {
        "name": "Tickets",
        "record_schema_path": "schemas/entities/sync-row.schema.json",
        "supports_incremental": true,
        "supports_full_sync": true,
        "supports_webhook": false,
        "default_sync_interval_minutes": 15,
        "max_batch_size": 100
      },
      "users": {
        "name": "Users",
        "record_schema_path": "schemas/entities/sync-row.schema.json",
        "supports_incremental": true,
        "supports_full_sync": true,
        "supports_webhook": false,
        "default_sync_interval_minutes": 60,
        "max_batch_size": 100
      },
      "organizations": {
        "name": "Organizations",
        "record_schema_path": "schemas/entities/sync-row.schema.json",
        "supports_incremental": true,
        "supports_full_sync": true,
        "supports_webhook": false,
        "default_sync_interval_minutes": 60,
        "max_batch_size": 100
      }
    },
    "actions": [
      {
        "key": "zendesk_get_me",
        "definition_path": "actions/get-me/definition.json"
      },
      {
        "key": "zendesk_list_tickets",
        "definition_path": "actions/list-tickets/definition.json"
      },
      {
        "key": "zendesk_list_users",
        "definition_path": "actions/list-users/definition.json"
      },
      {
        "key": "zendesk_list_organizations",
        "definition_path": "actions/list-organizations/definition.json"
      }
    ]
  }
}
