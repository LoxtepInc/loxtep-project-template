{
  "key": "shopify_get_inventory_levels",
  "name": "Get inventory levels",
  "description": "List inventory levels from the Shopify Admin REST API (GET /inventory_levels.json).",
  "version": "1.0.0",
  "type": "action",
  "supported_ingestion_modes": ["scheduled_poll"],
  "annotations": { "read_only": true, "destructive": false },
  "required_scopes": ["read_inventory"],
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "limit": { "type": "integer", "minimum": 1, "maximum": 250, "default": 50 },
      "updated_at_min": { "type": "string", "format": "date-time" },
      "page_info": { "type": "string" }
    }
  },
  "execution": {
    "protocol": "catalog_http_get",
    "method": "GET",
    "base_url_template": "https://{{connection.custom_settings.shop_domain}}/admin/api/{{connection.custom_settings.api_version}}",
    "path": "/inventory_levels.json",
    "header_auth": {
      "header": "X-Shopify-Access-Token",
      "value_from": "connection.oauth_access_token"
    },
    "query_mapping": {
      "limit": "input.limit",
      "updated_at_min": "input.updated_at_min",
      "page_info": "input.page_info"
    },
    "omit_empty_query": true
  }
}
