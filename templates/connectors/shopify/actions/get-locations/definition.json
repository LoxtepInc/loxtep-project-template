{
  "key": "shopify_get_locations",
  "name": "Get locations",
  "description": "List store locations from the Shopify Admin REST API (GET /locations.json).",
  "version": "1.0.0",
  "type": "action",
  "annotations": { "read_only": true, "destructive": false },
  "required_scopes": ["read_locations"],
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "limit": { "type": "integer", "minimum": 1, "maximum": 250, "default": 50 }
    }
  },
  "execution": {
    "protocol": "catalog_http_get",
    "method": "GET",
    "base_url_template": "https://{{connection.custom_settings.shop_domain}}/admin/api/{{connection.custom_settings.api_version}}",
    "path": "/locations.json",
    "header_auth": {
      "header": "X-Shopify-Access-Token",
      "value_from": "connection.oauth_access_token"
    },
    "query_mapping": {
      "limit": "input.limit"
    },
    "omit_empty_query": true
  }
}
