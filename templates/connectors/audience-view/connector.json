{
  "$schema": "https://loxtep.io/schemas/template/connector.json",
  "template_type": "connector",
  "catalog_visible": true,
  "slug": "audience-view",
  "name": "AudienceView Unlimited",
  "description": "Ingest customers and orders from AudienceView Unlimited WebAPI v2 via session login and the search business object.",
  "version": "1.0.0",
  "tags": ["audience-view", "audienceview", "ticketing", "performing-arts"],
  "use_cases": [
    "Sync patrons (customers) and box-office orders from an Unlimited WebAPI host into Loxtep."
  ],
  "entity": {
    "connector_id": "{{CONNECTOR_ID}}",
    "organization_id": "{{ORGANIZATION_ID}}",
    "project_id": "{{PROJECT_ID}}",
    "connector_type": "audience-view",
    "name": "AudienceView Unlimited",
    "description": "Unlimited WebAPI v2 session auth (userid/password) and search-based inbound sync for customers and orders.",
    "category": "custom",
    "icon_url": "https://www.audienceview.com/favicon.ico",
    "documentation_url": "https://developer.audienceview.com/",
    "auth_type": "basic",
    "oauth_config": null,
    "supported_directions": ["inbound"],
    "supported_entities": ["customers", "orders"],
    "supports_webhooks": false,
    "supports_polling": true,
    "required_scopes": null,
    "required_permissions": [
      "Ingestion only. Do not map card numbers, PAN, or other payment secrets."
    ],
    "version": "1.0.0",
    "is_beta": true,
    "custom_settings_schema": {
      "base_url": {
        "type": "string",
        "help": "HTTPS origin of the Unlimited WebAPI host (no path). Example: https://tickets.example.com",
        "x-direction": "connection"
      },
      "role": {
        "type": "string",
        "help": "Optional Unlimited user role sent as SET::role on authenticateUser. Leave blank to use the account default (often Internet).",
        "x-direction": "connection"
      },
      "api_key": {
        "type": "string",
        "help": "Optional api_key query parameter shown on entity URLs in the developer docs. Omit unless your host requires it.",
        "x-direction": "connection",
        "x-secret": true
      }
    },
    "metadata": {
      "template_slug": "audience-view",
      "trigger_config_spec": {
        "required": ["sync_entity"],
        "optional": [],
        "fields": {
          "sync_entity": {
            "type": "string",
            "description": "WebAPI search object to sync.",
            "enum": ["customers", "orders"],
            "default": "customers"
          }
        }
      }
    },
    "created_at": "{{CREATED_AT}}",
    "updated_at": "{{UPDATED_AT}}"
  },
  "connection_template": {
    "type": "api",
    "configuration": {
      "auth_type": "basic",
      "username": "{{API_USERNAME}}",
      "password": "{{API_PASSWORD}}",
      "custom_settings": {
        "base_url": "{{BASE_URL}}",
        "role": "{{ROLE}}",
        "api_key": "{{API_KEY}}"
      }
    }
  },
  "placeholders": {
    "{{CONNECTOR_ID}}": "Generated UUID for the connector",
    "{{ORGANIZATION_ID}}": "Organization that owns this connector",
    "{{PROJECT_ID}}": "Project that contains this connector",
    "{{BASE_URL}}": "HTTPS origin of the Unlimited site (api_url). No path.",
    "{{API_USERNAME}}": "WebAPI userid (Desktop-style API user)",
    "{{API_PASSWORD}}": "WebAPI user password",
    "{{ROLE}}": "Optional SET::role on authenticateUser; blank uses default role",
    "{{API_KEY}}": "Optional api_key query param; leave blank if unused",
    "{{CREATED_AT}}": "ISO 8601 timestamp",
    "{{UPDATED_AT}}": "ISO 8601 timestamp"
  },
  "connector_package": {
    "schema_version": 1,
    "package_version": "1.0.0",
    "use_catalog_runtime": true,
    "description": "AudienceView Unlimited WebAPI v2 via CatalogRuntimeConnector. Session login + search BO for customers and orders.",
    "follow_up_notes": [
      "Auth: POST /app/WebAPI/v2/session/authenticateUser with userid, password, optional SET::role; keep cookie name session; errorCode 99 means re-login.",
      "Bulk ingest uses search (not customer/order load-by-id). ResultMember field paths may need tuning per tenant Registry after the first live response.",
      "records_path return.Result assumes the documented get Result envelope; confirm against a live host (triads / map vs array).",
      "api_key query param is optional until a host proves it required.",
      "Phase 2: performances/gifts via content search; admissions as order associations; non-default role omit-empty on login if empty SET::role is rejected.",
      "Test connection and sync need a tenant base_url plus WebAPI username/password."
    ],
    "execution_policy": {
      "allowed_hosts_from_connection": ["base_url", "custom_settings.base_url"],
      "allowed_path_patterns": [
        "^/app/WebAPI/v2/session/authenticateUser$",
        "^/app/WebAPI/v2/session/logout$",
        "^/app/WebAPI/v2/search$"
      ]
    },
    "session_auth": {
      "login": {
        "method": "POST",
        "base_url_template": "{{connection.base_url}}",
        "path": "/app/WebAPI/v2/session/authenticateUser",
        "static_headers": {
          "Accept": "application/json",
          "Content-Type": "application/json"
        },
        "json_body": {
          "userid": "{{connection.username}}",
          "password": "{{connection.password}}",
          "SET::role": "{{connection.custom_settings.role}}"
        }
      },
      "cookie_names": ["session"],
      "expired": {
        "status": 200,
        "body_path": "errorCode",
        "equals": "99"
      }
    },
    "connection_probe": {
      "action_key": "audience_view_search_customers",
      "records_path": "return",
      "required_field": "Result",
      "probe_input": {
        "limit": 1,
        "page": 1
      }
    },
    "sync_plan": {
      "entities": {
        "customers": {
          "fetch_action_key": "audience_view_search_customers",
          "records_path": "return.Result",
          "pagination": "query_page",
          "page_query_param": "page",
          "id_field": "customer_id",
          "cursor_field": "customer_id",
          "fetch_limit_cap": 100,
          "sync_input_defaults": {
            "page": 1,
            "limit": 100
          }
        },
        "orders": {
          "fetch_action_key": "audience_view_search_orders",
          "records_path": "return.Result",
          "pagination": "query_page",
          "page_query_param": "page",
          "id_field": "order_id",
          "cursor_field": "order_id",
          "fetch_limit_cap": 100,
          "sync_input_defaults": {
            "page": 1,
            "limit": 100
          }
        }
      }
    },
    "entity_catalog": {
      "customers": {
        "name": "Customers",
        "record_schema_path": "schemas/entities/customer.schema.json",
        "description": "Patrons from Unlimited search (object customer). No card or PAN fields.",
        "supports_incremental": false,
        "supports_full_sync": true,
        "supports_webhook": false,
        "default_sync_interval_minutes": 30,
        "max_batch_size": 100
      },
      "orders": {
        "name": "Orders",
        "record_schema_path": "schemas/entities/order.schema.json",
        "description": "Box-office orders from Unlimited search (object order). No card or PAN fields.",
        "supports_incremental": false,
        "supports_full_sync": true,
        "supports_webhook": false,
        "default_sync_interval_minutes": 30,
        "max_batch_size": 100
      }
    },
    "actions": [
      {
        "key": "audience_view_search_customers",
        "definition_path": "actions/search-customers/definition.json"
      },
      {
        "key": "audience_view_search_orders",
        "definition_path": "actions/search-orders/definition.json"
      }
    ]
  }
}
