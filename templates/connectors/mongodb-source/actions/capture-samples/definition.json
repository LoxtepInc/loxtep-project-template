{
  "key": "mongodb_source_capture_samples",
  "name": "Pull collection sample",
  "description": "Bounded find (1–25 docs) from one collection on connectors-private-512. Does not start CDC or ingest.",
  "version": "1.0.0",
  "type": "action",
  "annotations": {
    "runtime_kind": "platform_native",
    "provider_slug": "mongodb-source",
    "operation": "capture_samples",
    "read_only": true,
    "destructive": false
  },
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "entity_type": {
        "type": "string",
        "description": "Collection name from mongodb_source_list_collections."
      },
      "limit": { "type": "integer", "minimum": 1, "maximum": 25, "default": 5 },
      "instance_id": { "type": "string" }
    },
    "required": ["entity_type"]
  },
  "execution": {
    "protocol": "platform_native",
    "provider": "mongodb-source",
    "operation": "capture_samples"
  }
}
