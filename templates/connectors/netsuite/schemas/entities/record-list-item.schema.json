{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loxtep:connector:netsuite:entity:record-list-item",
  "title": "NetSuite REST collection item",
  "description": "Element of REST record collection `items[]` (often id + self link until hydrated).",
  "type": "object",
  "required": ["id"],
  "properties": {
    "id": { "type": "string" },
    "links": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    }
  },
  "additionalProperties": true
}
