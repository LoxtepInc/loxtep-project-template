{
  "$schema": "https://loxtep.io/schemas/template/connector.json",
  "template_type": "connector",
  "slug": "expensify",
  "name": "Expensify Connector",
  "description": "Expensify Integration Server — expense policies and report export via Catalog HTTP (form-urlencoded).",
  "version": "1.0.0",
  "tags": [
    "expensify",
    "accounting",
    "finance",
    "expenses",
    "policies"
  ],
  "use_cases": [
    "Sync Expensify policy list into the mesh",
    "Export expense reports for a date range (CSV via Integration Server)",
    "Finance domain expenses alongside Xero / Bill.com / QuickBooks"
  ],
  "entity": {
    "connector_id": "{{CONNECTOR_ID}}",
    "organization_id": "{{ORGANIZATION_ID}}",
    "project_id": "{{PROJECT_ID}}",
    "connector_type": "expensify",
    "name": "Expensify",
    "description": "Expensify Integration Server via CatalogRuntimeConnector (partnerUserID + partnerUserSecret, form-urlencoded POST).",
    "category": "finance",
    "auth_type": "api_key",
    "oauth_config": null,
    "supported_directions": [
      "inbound"
    ],
    "supported_entities": [
      "policies"
    ],
    "supports_webhooks": false,
    "supports_polling": true,
    "required_scopes": null,
    "version": "1.0.0",
    "is_beta": true,
    "documentation_url": "https://integrations.expensify.com/",
    "metadata": {
      "template_slug": "expensify"
    },
    "created_at": "{{CREATED_AT}}",
    "updated_at": "{{UPDATED_AT}}"
  },
  "connection_template": {
    "type": "api",
    "configuration": {
      "api_key": "{{PARTNER_USER_SECRET}}",
      "partner_user_id": "{{PARTNER_USER_ID}}"
    }
  },
  "placeholders": {
    "{{CONNECTOR_ID}}": "Generated UUID for the connector",
    "{{ORGANIZATION_ID}}": "Organization that owns this connector",
    "{{PROJECT_ID}}": "Project that contains this connector",
    "{{PARTNER_USER_ID}}": "Expensify partnerUserID from https://www.expensify.com/tools/integrations/ (custom_settings.partner_user_id)",
    "{{PARTNER_USER_SECRET}}": "Expensify partnerUserSecret (stored as api_key)",
    "{{CREATED_AT}}": "ISO 8601 timestamp",
    "{{UPDATED_AT}}": "ISO 8601 timestamp"
  },
  "connector_package": {
    "schema_version": 1,
    "package_version": "1.0.0",
    "use_catalog_runtime": true,
    "description": "Expensify Integration Server. All jobs POST application/x-www-form-urlencoded to /Integration-Server/ExpensifyIntegrations with requestJobDescription JSON (credentials embedded). Requires platform form_body support (LOX-1966).",
    "follow_up_notes": [
      "Report export returns a generated filename (download via separate downloader job) — exposed as expensify_export_reports action, not a sync entity.",
      "Generate credentials at https://www.expensify.com/tools/integrations/ (partnerUserID + partnerUserSecret).",
      "Optional userEmail on policy list scopes policies for another domain user you can access."
    ],
    "platform_dependencies": [
      {
        "id": "catalog_http_form_urlencoded",
        "kind": "platform_capability",
        "severity": "required",
        "title": "Catalog HTTP form-urlencoded POST",
        "description": "Declarative catalog executor must support execution.form_body → application/x-www-form-urlencoded (LOX-1966 / loxtep PR).",
        "documentation_url": "https://integrations.expensify.com/"
      }
    ],
    "execution_policy": {
      "allowed_host_suffixes": [
        "integrations.expensify.com"
      ],
      "allowed_path_patterns": [
        "^/Integration-Server/ExpensifyIntegrations$"
      ]
    },
    "connection_probe": {
      "action_key": "expensify_list_policies",
      "records_path": "policyList",
      "required_field": "id",
      "probe_input": {
        "admin_only": true
      },
      "account_info_mapping": {
        "sample_policy_id": "id",
        "sample_policy_name": "name"
      }
    },
    "sync_plan": {
      "entities": {
        "policies": {
          "fetch_action_key": "expensify_list_policies",
          "records_path": "policyList",
          "pagination": "none",
          "id_field": "id",
          "sync_input_defaults": {
            "admin_only": true
          }
        }
      }
    },
    "entity_catalog": {
      "policies": {
        "name": "Policies",
        "record_schema_path": "schemas/entities/expensify-policy.schema.json",
        "description": "Expensify expense policies (policy list getter)",
        "supports_incremental": false,
        "supports_full_sync": true,
        "supports_webhook": false,
        "default_sync_interval_minutes": 60,
        "max_batch_size": 500
      }
    },
    "actions": [
      {
        "key": "expensify_list_policies",
        "definition_path": "actions/list-policies/definition.json"
      },
      {
        "key": "expensify_export_reports",
        "definition_path": "actions/export-reports/definition.json"
      }
    ]
  }
}
