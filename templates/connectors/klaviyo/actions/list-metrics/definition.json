{
  "key": "klaviyo_list_metrics",
  "name": "List metrics",
  "description": "GET /api/metrics. Revision 2026-10-15 accepts page[cursor] and does not accept page[size]; the API returns at most 200 metrics per page. limit is not sent.",
  "version": "1.1.0",
  "type": "action",
  "annotations": { "read_only": true, "destructive": false },
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "page[cursor]": {
        "type": "string",
        "description": "JSON:API cursor from links.next. page[size] is not a parameter on revision 2026-10-15."
      }
    }
  },
  "execution": {
    "protocol": "catalog_http_get",
    "method": "GET",
    "base_url_template": "https://a.klaviyo.com",
    "path": "/api/metrics",
    "static_headers": {
      "revision": "2026-10-15",
      "Accept": "application/vnd.api+json"
    },
    "header_auth": {
      "header": "Authorization",
      "value_from": "connection.api_key",
      "prefix": "Klaviyo-API-Key "
    },
    "query_mapping": {
      "page[cursor]": "input.page[cursor]"
    },
    "omit_empty_query": true
  }
}
